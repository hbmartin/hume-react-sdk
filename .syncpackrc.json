{
  "$schema": "./node_modules/syncpack/schema.json",
  "versionGroups": [
    {
      "label": "Published React peer floors and installed React versions intentionally differ",
      "dependencies": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ],
      "isIgnored": true
    }
  ],
  "semverGroups": [
    {
      "label": "Published React peer ranges remain open",
      "dependencies": ["react", "react-dom"],
      "dependencyTypes": ["peer"],
      "range": ">="
    },
    {
      "label": "Installed React and React type dependencies use caret ranges",
      "dependencies": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ],
      "dependencyTypes": ["prod", "dev"],
      "range": "^"
    },
    {
      "label": "Static-analysis toolchain versions are pinned",
      "dependencies": [
        "@arethetypeswrong/cli",
        "@microsoft/api-extractor",
        "@types/node",
        "cspell",
        "fallow",
        "markdownlint-cli2",
        "oxfmt",
        "oxlint",
        "oxlint-tsgolint",
        "publint",
        "syncpack",
        "tsup",
        "typescript"
      ],
      "range": ""
    }
  ]
}
