  },
  "devDependencies": {
    "@humeai/typescript-config": "workspace:*",
    "@types/node": "22.20.1",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "7.0.2",
    "vite": "^6.4.3"
  }
}
