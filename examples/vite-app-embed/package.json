{
  "name": "example-vite-app-embed",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3002 --strictPort",
    "build": "vite build",
    "test": "vitest run",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives .",
    "typecheck": "tsc --build tsconfig.node.json && tsc --noEmit -p .",
    "typecheck:deps": "tsc --build --force tsconfig.node.json && tsc --noEmit -p tsconfig.deps.json",
    "preview": "vite preview"
  },
  "dependencies": {
    "@humeai/voice-embed-react": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@humeai/typescript-config": "workspace:*",
    "@humeai/vitest-config": "workspace:*",
    "@types/node": "22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
