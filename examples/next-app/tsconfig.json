{
  "extends": "@humeai/typescript-config/nextjs.json",
  "compilerOptions": {
    "incremental": true
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "utils/**/*.ts",
    "utils/**/*.tsx",
    "types/**/*.d.ts",
    "*.config.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["dist", "coverage", "node_modules"]
}
