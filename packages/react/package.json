{
  "name": "@humeai/voice-react",
  "version": "0.3.0-beta.7",
  "description": "Headless React hooks and components for building a custom voice interface on Hume's Empathic Voice Interface (EVI).",
  "keywords": [
    "ai",
    "conversational ai",
    "empathic voice interface",
    "evi",
    "hooks",
    "hume",
    "react",
    "speech",
    "voice",
    "websocket"
  ],
  "homepage": "https://github.com/HumeAI/hume-react-sdk",
  "bugs": {
    "url": "https://github.com/HumeAI/hume-react-sdk/issues"
  },
  "license": "ISC",
  "author": "Hume AI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HumeAI/hume-react-sdk.git",
    "directory": "packages/react"
  },
  "files": [
    "LICENSE",
    "MIGRATION.md",
    "package.json",
    "dist"
  ],
  "type": "commonjs",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "test-watch": "vitest --watch",
    "build": "tsup && pnpm build:types",
    "build:types": "tsc -p tsconfig.build.json && api-extractor run --local --config api-extractor.build.json && pnpm --dir ../.. finalize-types packages/react",
    "dev": "tsup --watch",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives src vitest.config.mts tsup.config.ts",
    "typecheck": "tsc --noEmit -p .",
    "typecheck:deps": "tsc --noEmit -p tsconfig.deps.json",
    "package:check": "publint && attw --pack . --profile node16 && pnpm --dir ../.. package:smoke packages/react",
    "api-report:check": "api-extractor run --config api-extractor.json",
    "api-report:update": "api-extractor run --local --config api-extractor.json",
    "pack": "npm pack"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "hume": "0.16.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@humeai/typescript-config": "workspace:*",
    "@humeai/vitest-config": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@total-typescript/shoehorn": "^0.1.2",
    "@types/node": "22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
