{
  "name": "@humeai/voice-react",
  "version": "0.3.0-beta.7",
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HumeAI/hume-react-sdk.git",
    "directory": "packages/react"
  },
  "files": [
    "package.json",
    "dist"
  ],
  "type": "commonjs",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "test-watch": "vitest --watch",
    "build": "tsup && pnpm build:types",
    "build:types": "tsc -p tsconfig.build.json && api-extractor run --local --config api-extractor.build.json && pnpm --dir ../.. finalize-types packages/react",
    "dev": "tsup --watch",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives src vitest.config.mts tsup.config.ts",
    "typecheck": "tsc --noEmit -p .",
    "typecheck:deps": "tsc --noEmit -p tsconfig.deps.json",
    "package:check": "publint && attw --pack . --profile node16 && pnpm --dir ../.. package:smoke packages/react",
    "api-report:check": "api-extractor run --config api-extractor.json",
    "api-report:update": "api-extractor run --local --config api-extractor.json",
    "pack": "npm pack"
  },
  "dependencies": {
    "date-fns": "^3.6.0",
    "hume": "0.16.1",
    "type-fest": "^4.26.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@humeai/typescript-config": "workspace:*",
    "@humeai/vitest-config": "workspace:*",
    "@testing-library/react": "^14.2.2",
    "@testing-library/react-hooks": "^8.0.1",
    "@total-typescript/shoehorn": "^0.1.2",
    "@types/node": "22.20.1",
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "jsdom": "^24.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "vitest": "^3.2.6"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}
