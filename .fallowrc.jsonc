{
  "$schema": "./node_modules/fallow/schema.json",
  "minimumVersion": "3.22.0",
  "sealed": true,
  "entry": [
    ".pnpmfile.cjs",
    "packages/react/src/worklets/audio-worklet-20250702.js",
  ],
  "ignorePatterns": [
    "**/dist/**",
    "**/.next/**",
    "**/coverage/**",
    "**/etc/*.api.md",
    "examples/next-app/next-env.d.ts",
    ".fallow-baselines/**",
    "packages/core/**",
    "tools/lint-contract/fixtures/**",
  ],
  "ignoreDependencies": [
    // Invoked through its api-documenter CLI binary by the docs generator.
    "@microsoft/api-documenter",
  ],
  "typeAware": {
    "enabled": true,
    "projects": [
      "tsconfig.json",
      "packages/embed/tsconfig.json",
      "packages/embed-react/tsconfig.json",
      "packages/react/tsconfig.json",
      "examples/next-app/tsconfig.json",
      "examples/vite-app/tsconfig.json",
      "examples/vite-app-embed/tsconfig.json",
      "examples/vite-app-embed/tsconfig.node.json",
      "tools/lint-contract/tsconfig.json",
      "tools/vitest-config/tsconfig.json",
    ],
    "require": "complete",
  },
  "usedClassMembers": [
    "clear",
    "create",
    "destroy",
    "getServerSnapshot",
    "getSnapshot",
    "mount",
    "subscribe",
    "write",
  ],
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "private-type-leaks": "error",
    "unused-dependencies": "error",
    "unused-dev-dependencies": "error",
    "unused-optional-dependencies": "error",
    "unresolved-imports": "error",
    "unlisted-dependencies": "error",
    "type-only-dependencies": "error",
    "test-only-dependencies": "error",
    "dev-dependencies-in-production": "error",
    "duplicate-exports": "error",
    "circular-dependencies": "error",
    "re-export-cycle": "error",
    "boundary-violation": "error",
    "stale-suppressions": "error",
    "require-suppression-reason": "error",
  },
  "duplicates": {
    "mode": "semantic",
    "near": true,
    "ignore": ["packages/react/src/worklets/audio-worklet-20250702.js"],
  },
  "health": {
    "coverage": "coverage/coverage-final.json",
    "ignore": [
      "**/*.test.{js,mjs,cjs,ts,tsx}",
      "**/*.spec.{js,mjs,cjs,ts,tsx}",
      "packages/react/src/worklets/audio-worklet-20250702.js",
      "tools/**",
    ],
  },
  "overrides": [
    {
      // VitePress emits these theme classes at runtime, outside source markup.
      "files": ["docs/.vitepress/theme/style.css"],
      "rules": { "css-dead-surface": "off" },
    },
  ],
  "boundaries": {
    "zones": [
      {
        "name": "voice-embed",
        "patterns": ["packages/embed/src/**"],
      },
      {
        "name": "voice-embed-react",
        "patterns": ["packages/embed-react/src/**"],
      },
      {
        "name": "voice-react",
        "patterns": ["packages/react/src/**"],
      },
      {
        "name": "examples-source",
        "patterns": [
          "examples/*/src/**",
          "examples/*/index.html",
          "examples/next-app/app/**",
          "examples/next-app/components/**",
          "examples/next-app/types/**",
          "examples/next-app/utils/**",
        ],
      },
      {
        "name": "workspace-configuration",
        "patterns": [
          ".pnpmfile.cjs",
          "*.config.{js,cjs,mjs,ts,mts,cts}",
          "packages/*/*.config.{js,cjs,mjs,ts,mts,cts}",
          "examples/*/*.config.{js,cjs,mjs,ts,mts,cts}",
        ],
      },
      {
        "name": "documentation",
        "patterns": ["docs/**"],
      },
      {
        "name": "tools",
        "patterns": ["tools/**"],
      },
    ],
    "rules": [
      {
        "from": "voice-embed",
        "allow": ["voice-embed"],
      },
      {
        "from": "voice-embed-react",
        "allow": ["voice-embed-react", "voice-embed"],
      },
      {
        "from": "voice-react",
        "allow": ["voice-react"],
      },
      {
        "from": "examples-source",
        "allow": [
          "examples-source",
          "voice-embed",
          "voice-embed-react",
          "voice-react",
        ],
      },
      {
        "from": "workspace-configuration",
        "allow": ["workspace-configuration", "tools"],
      },
      {
        "from": "documentation",
        "allow": ["documentation", "tools"],
      },
      {
        "from": "tools",
        "allow": ["tools"],
      },
    ],
    "coverage": {
      "requireAllFiles": true,
    },
  },
  "audit": {
    "gate": "new-only",
    "typeAware": true,
  },
}
