{
  "name": "voice-sdk",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "build:packages": "turbo build --filter='./packages/**'",
    "dev": "turbo dev",
    "dev:iframe": "turbo run dev --filter='./packages/**' --filter=example-vite-app-embed",
    "docs:api": "pnpm build:packages && node tools/generate-api-docs.mjs",
    "docs:build": "pnpm docs:api && vitepress build docs",
    "docs:dev": "pnpm docs:api && vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "lint": "pnpm build:packages && oxlint --disable-nested-config --type-aware --deny-warnings --report-unused-disable-directives . && pnpm lint:contracts",
    "lint:contracts": "node --test tools/lint-contract/config.test.mjs",
    "typecheck": "turbo typecheck && pnpm typecheck:tools",
    "typecheck:tools": "tsc --noEmit -p tools/tsconfig.json",
    "typecheck:deps": "turbo typecheck:deps",
    "test": "pnpm test:tools && turbo test",
    "test:coverage": "pnpm build:packages && pnpm test:tools && vitest run --config vitest.config.mts --coverage",
    "test:tools": "node --test tools/*.test.mjs",
    "test-watch": "turbo test-watch",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "finalize-types": "node tools/finalize-types.mjs",
    "package:smoke": "node tools/check-package-exports.mjs",
    "check:fallow": "pnpm check:fallow:dead-code && pnpm check:fallow:health && pnpm check:fallow:dupes",
    "check:fallow:dead-code": "fallow dead-code --no-cache --type-aware --type-aware-require complete --fail-on-issues",
    "check:fallow:health": "node tools/quality-gate/check-coverage-map.mjs && fallow health --no-cache --complexity --score --coverage coverage/coverage-final.json --baseline .fallow-baselines/health.json --baseline-mode identity --report-only --format json --output-file coverage/fallow-health.json && node tools/quality-gate/check-fallow-coverage.mjs coverage/fallow-health.json",
    "check:fallow:dupes": "fallow dupes --no-cache --baseline .fallow-baselines/dupes.json --fail-on-issues",
    "check:fallow:baselines": "node tools/quality-gate/check-fallow-baseline-policy.mjs",
    "check:fallow:baselines:preview": "node tools/quality-gate/preview-fallow-baselines.mjs",
    "check:fallow:audit": "node tools/quality-gate/run-fallow-audit.mjs",
    "check:deps": "syncpack lint",
    "check:docs": "cspell --dot --no-progress --no-summary \"**/*.{cjs,css,js,json,jsonc,md,mjs,mts,ts,tsx,yaml,yml}\" && markdownlint-cli2",
    "check:packages": "pnpm build:packages && pnpm --recursive --filter='./packages/**' package:check",
    "api-report:check": "pnpm build:packages && pnpm --recursive --filter='./packages/**' api-report:check",
    "api-report:update": "pnpm build:packages && pnpm --recursive --filter='./packages/**' api-report:update",
    "check": "pnpm build && pnpm lint && pnpm typecheck && pnpm typecheck:deps && pnpm format:check && pnpm check:deps && pnpm check:docs && pnpm test:coverage && pnpm check:fallow && pnpm check:fallow:baselines && pnpm check:packages && pnpm api-report:check",
    "release": "node tools/run-release.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@humeai/typescript-config": "workspace:*",
    "@microsoft/api-documenter": "7.30.13",
    "@microsoft/api-extractor": "7.59.0",
    "@types/node": "22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-istanbul": "^4.1.11",
    "cspell": "10.2.0",
    "fallow": "3.22.0",
    "markdownlint-cli2": "0.23.2",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "publint": "0.3.24",
    "syncpack": "15.3.3",
    "turbo": "^2.10.12",
    "vitepress": "1.6.4",
    "vitest": "^4.1.11"
  },
  "browserslist": [
    "last 2 Chrome versions, last 2 iOS major versions, Firefox ESR, not dead"
  ],
  "engines": {
    "node": ">=22.18",
    "pnpm": "11.25.0"
  },
  "packageManager": "pnpm@11.25.0"
}
