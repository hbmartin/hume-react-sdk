{
  "name": "voice-sdk",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "build:packages": "turbo build --filter='./packages/**'",
    "dev": "turbo dev",
    "dev:iframe": "turbo run dev --filter='./packages/**' --filter=example-vite-app-embed",
    "lint": "eslint ./tools/vitest-config/base.mts && turbo lint",
    "test": "turbo test",
    "test-watch": "turbo test-watch",
    "format": "prettier --write \"**/*.{ts,tsx,mts,md}\"",
    "release": "pnpm install && pnpm build:packages && pnpm publish -r --access public --no-git-checks"
  },
  "devDependencies": {
    "@humeai/eslint-config": "workspace:*",
    "@humeai/typescript-config": "workspace:*",
    "eslint": "^8.56.0",
    "prettier": "^3.7.4",
    "turbo": "^2.9.14"
  },
  "browserslist": [
    "last 2 Chrome versions, last 2 iOS major versions, Firefox ESR, not dead"
  ],
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.13",
    "pnpm": "11.24.0"
  }
}
